{
  "name": "@papchat/core",
  "description": "papchat networking and state: lobby, rooms, stages, invites, file transfer, ringtones, devices",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "core"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium",
    "denoise": "d=../../../node_modules/@sapphi-red/web-noise-suppressor && o=../../pages/app/asset/audio/denoise && mkdir -p $o && cp $d/dist/rnnoise/workletProcessor.js $o/rnnoise-worklet.js && cp $d/dist/gtcrn/workletProcessor.js $o/gtcrn-worklet.js && cp $d/dist/rnnoise.wasm $d/dist/rnnoise_simd.wasm $d/dist/gtcrn.wasm $d/LICENSE $o/"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LicenseRef-Papit-1.0",
  "homepage": "https://github.com/onkelhoy/papchat/tree/main/packages/foundations/core",
  "bugs": {
    "url": "https://github.com/onkelhoy/papchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papchat.git",
    "directory": "packages/foundations/core"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/signals": "*",
    "@papit/webrtc": "*",
    "@sapphi-red/web-noise-suppressor": "0.4.1"
  },
  "devDependencies": {
    "@papit/codeblock": "*",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "core",
    "htmlprefix": "",
    "components": {
      "core": {
        "className": "Core",
        "htmlprefix": "pc"
      }
    }
  }
}
