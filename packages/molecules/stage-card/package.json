{
  "name": "@papchat/stage-card",
  "description": "Live broadcast entry with watch button",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "stage-card"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build --error",
    "analyse": "npx @papit/analyse",
    "generate:react": "npx @papit/react",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/papchat/tree/main/packages/molecules/stage-card",
  "bugs": {
    "url": "https://github.com/onkelhoy/papchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papchat.git",
    "directory": "packages/molecules/stage-card"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/web-component": "*",
    "@papit/translator": "*",
    "@papit/button": "*",
    "@papchat/avatar": "*",
    "@papchat/badge": "*"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/codeblock": "*",
    "@papchat/core": "*",
    "@papchat/theme": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "web-component",
    "main": "stage-card",
    "htmlprefix": "pc",
    "components": {
      "stage-card": {
        "className": "StageCard",
        "htmlprefix": "pc"
      }
    }
  }
}
