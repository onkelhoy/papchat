{
  "name": "@papchat/app",
  "description": "The papchat page",
  "keywords": [
    "papit",
    "web-component",
    "typescript",
    "app"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live",
    "test": "npx playwright test -c tests/playwright.config.ts $@",
    "preversion": "papit-version",
    "postversion": "papit-version",
    "component": "npm create @papit -- --component",
    "test:update-snapshots": "npx playwright test --update-snapshots -c tests/playwright.config.ts",
    "test:chrome": "npm test -- --project=chromium"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/papchat/tree/main/packages/pages/app",
  "bugs": {
    "url": "https://github.com/onkelhoy/papchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/papchat.git",
    "directory": "packages/pages/app"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/signals": "*",
    "@papchat/theme": "*",
    "@papchat/core": "*",
    "@papchat/app-shell": "*",
    "@papchat/app-header": "*",
    "@papchat/member-list": "*",
    "@papchat/room-list": "*",
    "@papchat/conversation": "*",
    "@papchat/room": "*",
    "@papchat/toaster": "*",
    "@papchat/incoming-call": "*",
    "@papchat/invite-picker": "*",
    "@papchat/settings": "*",
    "@papchat/onboarding": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/translator": "*",
    "@papit/codeblock": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": true,
    "type": "browser",
    "main": "app",
    "htmlprefix": "",
    "components": {
      "app": {
        "className": "App",
        "htmlprefix": "pc"
      }
    }
  }
}
