{
    "name": "@papchat/root",
    "version": "0.0.0",
    "description": "a simple chat system hosted on static server exploring into the vast ecosystem of papit with main focus on the new webrtc, basically a webrtc demo ",
    "private": true,
    "scripts": {
        "analyse": "npm run analyse --workspaces --if-present",
        "clean": "node bin/clean.mjs",
        "build": "npx @papit/build",
        "test": "node bin/test.mjs",
        "create": "npm create @papit -- --package",
        "start": "npx @papit/server --info",
        "version:reset": "npx @papit/version --reset",
        "version:sync": "npx @papit/version --sync",
        "pages": "npm run build && cd packages/pages/app && npx @papit/static -- --base / --output ../../../docs --info",
        "signal": "npx @papit/signal-server --port 3001"
    },
    "keywords": [
        "typescript",
        "papit"
    ],
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=20"
    },
    "author": "henry",
    "license": "MIT",
    "workspaces": [
        "packages/**/*",
        "!packages/**/asset/**"
    ],
    "devDependencies": {
        "@papit/analyse": "*",
        "@papit/arguments": "*",
        "@papit/build": "*",
        "@papit/bundle-js": "*",
        "@papit/bundle-ts": "*",
        "@papit/create": "*",
        "@papit/information": "*",
        "@papit/react": "*",
        "@papit/server": "*",
        "@papit/signal-server": "*",
        "@papit/static": "*",
        "@papit/svg-spritesheet": "*",
        "@papit/terminal": "*",
        "@papit/version": "*",
        "esbuild": "0.27.2",
        "typescript": "5.9.3"
    },
    "papit": {
        "htmlprefix": "pc"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/papchat.git"
    },
    "dependencies": {
        "@papit/theme": "^0.0.3"
    }
}
